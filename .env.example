# ============================================================
# Argus — environment variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys.
#
# Phase 1 (Slice 1A) needs the first three. Rest are Phase 2+.

# --- Privy (auth + embedded EOA signer) ---
# Public; safe to ship to client. Create at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Alchemy (Base Sepolia RPC + simulation API) ---
# Server-side only. Create at https://dashboard.alchemy.com
# Create an app scoped to "Base Sepolia" network.
ALCHEMY_API_KEY=

# --- Pimlico (ERC-4337 bundler + verifying paymaster) ---
# Server-side only. Create at https://dashboard.pimlico.io
# Use the Base Sepolia endpoints.
PIMLICO_API_KEY=

# --- Phase 2 additions (leave blank for now) ---

# GoPlus Security API (token/address reputation)
# Free tier; see https://gopluslabs.io/security-api
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Basescan/Etherscan (ABI lookup, contract verification)
ETHERSCAN_API_KEY=

# --- Phase 4 (optional) ---

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=
